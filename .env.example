# Application Environment Configuration
APP_NAME=Medical Diagnosis Assistant
ENVIRONMENT=development
DEBUG=True

# Security & Authentication
JWT_SECRET_KEY=medical_assistant_secure_production_secret_key_change_me_987654321
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Database
DATABASE_URL=sqlite:///./data/app.db

# Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=8501

# CORS Origins (Comma-separated)
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# ML Model Paths (Optional custom overrides; defaults to backend/models_ml/...)
CHEST_IMAGE_MODEL_PATH=
CHEST_FUSION_MODEL_PATH=
BRAIN_IMAGE_MODEL_PATH=
BRAIN_FUSION_MODEL_PATH=

# ML Device Selection (auto, cuda, cpu)
DEVICE=auto
