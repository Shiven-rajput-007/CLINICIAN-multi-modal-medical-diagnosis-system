# Multi-Modal Medical Diagnosis Assistant - Backend Configuration
# Database Connection (PostgreSQL is default in production; SQLite supported as local fallback)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/medical_assistant
# For local SQLite fallback:
# DATABASE_URL=sqlite:///../data/app.db

# JWT & Authentication Security
JWT_SECRET_KEY=replace_with_a_secure_random_key_in_production_min32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# PyTorch Inference Engine Device ('cpu' or 'cuda' or 'auto')
MODEL_DEVICE=cpu

# Cross-Origin Resource Sharing (CORS)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local File Storage Directories
UPLOAD_DIR=storage/uploads
GRADCAM_DIR=storage/gradcam
MAX_UPLOAD_SIZE_MB=15

# Optional Custom Model Checkpoint Paths
# CHEST_IMAGE_MODEL_PATH=../models/chest_xray/densenet121_chest.pth
# CHEST_FUSION_MODEL_PATH=../models/chest_xray/fusion_chest.pth
# BRAIN_IMAGE_MODEL_PATH=../models/brain_mri/densenet121_brain.pth
# BRAIN_FUSION_MODEL_PATH=../models/brain_mri/fusion_brain.pth
