# Multi-Modal Medical Diagnosis Assistant - Production & Development Environment Configuration

# Environment mode ('production' or 'development')
# Set to 'production' on Render
ENVIRONMENT=production

# Database Connection (PostgreSQL is strictly required in production)
# Paste your Render PostgreSQL Internal Connection String here:
DATABASE_URL=postgresql+psycopg://medical_user:secret_password@dpg-xxxxxxxx-a.render.com:5432/medical_assistant_db
# For local development with SQLite fallback only:
# DATABASE_URL=sqlite:///../data/app.db

# JWT & Authentication Security (Minimum 32 random characters in production)
JWT_SECRET_KEY=generate_a_cryptographically_secure_random_key_min_32_chars_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# PyTorch Inference Engine Device ('cpu' required on Render 512 MiB tier)
MODEL_DEVICE=cpu

# Model Checkpoints Base Directory (optional, defaults to models/ or backend/models_ml/)
# MODEL_BASE_DIR=/opt/render/project/src/models

# Cross-Origin Resource Sharing (CORS) - Exact frontend domain(s)
# Replace with your actual Netlify frontend deployment URL:
CORS_ORIGINS=https://clinician-medical-diagnosis.netlify.app,http://localhost:5173

# Logging and Debugging (always false in production)
DEBUG=false
